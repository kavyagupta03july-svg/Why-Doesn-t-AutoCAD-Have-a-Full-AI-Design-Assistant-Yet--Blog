{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!assets/|src/assets/|favicon\\.svg|manifest\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
